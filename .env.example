# ==============================================================================
# AdScout — Variables de entorno (copia este archivo a .env y completa tus claves)
# Nunca subas .env ni claves reales al repositorio.
# ==============================================================================

# Base de datos SQLite local
ADSCOUT_DB_URL=sqlite:///data/adscout.db

# Directorios de configuración (relativos a la raíz del proyecto)
ADSCOUT_MARKETS_DIR=markets
ADSCOUT_SCORING_CONFIG=config/scoring.yaml
ADSCOUT_SAMPLE_DATA_DIR=sample_data
ADSCOUT_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Fase 2: Meta Ad Library API Oficial (solo anuncios comerciales en UE/UK)
# ------------------------------------------------------------------------------
META_ACCESS_TOKEN=
META_API_VERSION=v21.0
META_AD_TYPE=ALL
META_AD_ACTIVE_STATUS=ACTIVE
META_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# Fase 2: Apify (FUENTE DE PAGO OPCIONAL)
# ------------------------------------------------------------------------------
APIFY_API_TOKEN=
APIFY_ACTOR_ID=apify~facebook-ads-scraper
APIFY_TIMEOUT_SECONDS=120

# ------------------------------------------------------------------------------
# Fase 3: Módulos LLM Opcionales (con tope diario de gasto)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
PERPLEXITY_BASE_URL=https://api.perplexity.ai

# Tope diario de llamadas combinadas a proveedores LLM para controlar gasto
LLM_DAILY_CALL_LIMIT=25
